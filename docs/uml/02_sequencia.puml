@startuml
actor Aluno
participant "LoginController" as C
participant "UserRepository" as R
participant "PasswordEncoder" as Enc
participant "JWTCreator" as JWT
Aluno -> C : POST /login
C -> R : findByUsername
R --> C : User
C -> Enc : matches(senha, hash)
alt inválida
C --> Aluno : erro sem token
else válida
C -> JWT : criar JWTObject(roles, expiração)
JWT --> C : token
C --> Aluno : Sessao(login, token)
end
@enduml
